<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Design tokens for ZX0ai — reference design match.

        Light theme (reference): soft monochrome workspace.
        Dark theme: inverted equivalent, same visual hierarchy.
    -->

    <ResourceDictionary.ThemeDictionaries>

        <!-- ============================ Light ============================ -->
        <ResourceDictionary x:Key="Light">

            <!-- Planes, back to front. -->
            <SolidColorBrush x:Key="WindowBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="RailBrush" Color="#EFEFEF" />
            <SolidColorBrush x:Key="CanvasBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="PanelBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="RaisedBrush" Color="#FFFFFF" Opacity="0.72" />
            <SolidColorBrush x:Key="SunkenBrush" Color="#FFFFFF" Opacity="0.45" />
            <SolidColorBrush x:Key="FloatingBrush" Color="#FFFFFF" Opacity="0.65" />

            <!-- Ink. -->
            <SolidColorBrush x:Key="InkBrush" Color="#111111" />
            <SolidColorBrush x:Key="InkSecondaryBrush" Color="#686868" />
            <SolidColorBrush x:Key="InkTertiaryBrush" Color="#909090" />
            <SolidColorBrush x:Key="InkOnAccentBrush" Color="#FFFFFFFF" />

            <!-- Edges and overlays. -->
            <SolidColorBrush x:Key="HairlineBrush" Color="#D3D3D3" />
            <SolidColorBrush x:Key="HairlineStrongBrush" Color="#C8C8C8" />
            <SolidColorBrush x:Key="HoverBrush" Color="#000000" Opacity="0.035" />
            <SolidColorBrush x:Key="PressedBrush" Color="#000000" Opacity="0.065" />
            <SolidColorBrush x:Key="SelectedBrush" Color="#FFFFFF" Opacity="0.72" />

            <!-- Accent: monochrome dark for send/action, not blue. -->
            <SolidColorBrush x:Key="AccentBrush" Color="#111111" />
            <SolidColorBrush x:Key="AccentPressedBrush" Color="#111111" Opacity="0.7" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#111111" Opacity="0.08" />
            <SolidColorBrush x:Key="AccentInkBrush" Color="#111111" />

            <!-- Hero question text, painted behind everything on empty state. -->
            <SolidColorBrush x:Key="HeroInkBrush" Color="#111111" Opacity="0.18" />

            <!-- Amber for full-access warning chip. -->
            <SolidColorBrush x:Key="WarnBrush" Color="#C2600A" />

            <!-- Red for actual failures. -->
            <SolidColorBrush x:Key="DangerBrush" Color="#C02B2B" />

            <SolidColorBrush x:Key="ScrollThumbBrush" Color="#000000" Opacity="0.20" />

            <!-- Truncation fade overlay. -->
            <LinearGradientBrush x:Key="FadeToCanvasBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0.0" Color="#00F3F3F3" />
                <GradientStop Offset="1.0" Color="#FFF3F3F3" />
            </LinearGradientBrush>
        </ResourceDictionary>

        <!-- ============================ Dark ============================= -->
        <ResourceDictionary x:Key="Dark">

            <SolidColorBrush x:Key="WindowBrush" Color="#1A1A1A" />
            <SolidColorBrush x:Key="RailBrush" Color="#161616" />
            <SolidColorBrush x:Key="CanvasBrush" Color="#1A1A1A" />
            <SolidColorBrush x:Key="PanelBrush" Color="#1A1A1A" />
            <SolidColorBrush x:Key="RaisedBrush" Color="#FFFFFF" Opacity="0.12" />
            <SolidColorBrush x:Key="SunkenBrush" Color="#FFFFFF" Opacity="0.06" />
            <SolidColorBrush x:Key="FloatingBrush" Color="#FFFFFF" Opacity="0.10" />

            <SolidColorBrush x:Key="InkBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="InkSecondaryBrush" Color="#A0A0A0" />
            <SolidColorBrush x:Key="InkTertiaryBrush" Color="#707070" />
            <SolidColorBrush x:Key="InkOnAccentBrush" Color="#111111" />

            <SolidColorBrush x:Key="HairlineBrush" Color="#FFFFFF" Opacity="0.10" />
            <SolidColorBrush x:Key="HairlineStrongBrush" Color="#FFFFFF" Opacity="0.18" />
            <SolidColorBrush x:Key="HoverBrush" Color="#FFFFFF" Opacity="0.05" />
            <SolidColorBrush x:Key="PressedBrush" Color="#FFFFFF" Opacity="0.09" />
            <SolidColorBrush x:Key="SelectedBrush" Color="#FFFFFF" Opacity="0.18" />

            <SolidColorBrush x:Key="AccentBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="AccentPressedBrush" Color="#F3F3F3" Opacity="0.7" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#F3F3F3" Opacity="0.12" />
            <SolidColorBrush x:Key="AccentInkBrush" Color="#F3F3F3" />

            <SolidColorBrush x:Key="HeroInkBrush" Color="#F3F3F3" Opacity="0.18" />
            <SolidColorBrush x:Key="WarnBrush" Color="#F08A3C" />
            <SolidColorBrush x:Key="DangerBrush" Color="#E0554F" />

            <SolidColorBrush x:Key="ScrollThumbBrush" Color="#FFFFFF" Opacity="0.22" />

            <LinearGradientBrush x:Key="FadeToCanvasBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0.0" Color="#001A1A1A" />
                <GradientStop Offset="1.0" Color="#FF1A1A1A" />
            </LinearGradientBrush>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- ========================== Typography =========================== -->
    <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Cascadia Code, Consolas</FontFamily>

    <x:Double x:Key="FontSizeMicro">11</x:Double>
    <x:Double x:Key="FontSizeCaption">12</x:Double>
    <x:Double x:Key="FontSizeSmall">13</x:Double>
    <x:Double x:Key="FontSizeBody">14</x:Double>
    <x:Double x:Key="FontSizeSubtitle">16</x:Double>
    <x:Double x:Key="FontSizeTitle">20</x:Double>

    <!-- ============================ Spacing ============================ -->
    <!-- 4px base, 8px rhythm. Half-steps for optical alignment. -->
    <x:Double x:Key="Space050">2</x:Double>
    <x:Double x:Key="Space100">4</x:Double>
    <x:Double x:Key="Space150">6</x:Double>
    <x:Double x:Key="Space200">8</x:Double>
    <x:Double x:Key="Space300">12</x:Double>
    <x:Double x:Key="Space400">16</x:Double>
    <x:Double x:Key="Space500">20</x:Double>
    <x:Double x:Key="Space600">24</x:Double>
    <x:Double x:Key="Space800">32</x:Double>
    <x:Double x:Key="Space1000">40</x:Double>

    <Thickness x:Key="PanelPadding">12</Thickness>
    <Thickness x:Key="RowPadding">10,0</Thickness>
    <Thickness x:Key="CardPadding">12</Thickness>

    <!-- ============================= Motion ============================ -->
    <x:Double x:Key="DurationFastMs">120</x:Double>
    <x:Double x:Key="DurationBaseMs">180</x:Double>

    <!-- ============================= Shape ============================= -->
    <CornerRadius x:Key="RadiusSmall">8</CornerRadius>
    <CornerRadius x:Key="RadiusListItem">10</CornerRadius>
    <CornerRadius x:Key="RadiusCard">12</CornerRadius>
    <CornerRadius x:Key="RadiusPanel">18</CornerRadius>
    <CornerRadius x:Key="RadiusPill">22</CornerRadius>
    <CornerRadius x:Key="RadiusInputCapsule">24</CornerRadius>
    <CornerRadius x:Key="RadiusSegmented">20</CornerRadius>
    <CornerRadius x:Key="RadiusSearch">18</CornerRadius>
    <CornerRadius x:Key="RadiusWindowOuter">17</CornerRadius>

    <Thickness x:Key="HairlineThickness">1</Thickness>

    <!-- ============================ Metrics =========================== -->
    <x:Double x:Key="RailWidth">244</x:Double>
    <x:Double x:Key="ToolPanelWidth">320</x:Double>
    <x:Double x:Key="TopBarHeight">44</x:Double>
    <x:Double x:Key="RowHeightCompact">32</x:Double>
    <x:Double x:Key="RowHeightComfortable">38</x:Double>
    <x:Double x:Key="ComposerMaxWidth">860</x:Double>
    <x:Double x:Key="ComposerEmptyWidthRatio">0.68</x:Double>

</ResourceDictionary>