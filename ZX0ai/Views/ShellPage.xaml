<Page
    x:Class="ZX0ai.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ZX0ai.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:ZX0ai.Services"
    xmlns:local="using:ZX0ai.Views"
    xmlns:panels="using:ZX0ai.Views.Panels"
    xmlns:vm="using:ZX0ai.ViewModels"
    xmlns:models="using:ZX0ai.Core.Models"
    mc:Ignorable="d"
    SizeChanged="OnRootSizeChanged">

    <Page.Resources>
        <local:ChatRoleToVisibilityConverter x:Key="RoleToVisibilityConverter" />
    </Page.Resources>

    <!--
        Three regions, left to right: the conversations that exist, the one that is open,
        and what the open one is doing. Everything rendered here comes from real state —
        the rail lists files on disk, the model chip names the slug that will be called,
        and the run panel reports a turn that happened. There is no sample content, so an
        empty product looks empty.
    -->

    <Grid x:Name="RootGrid" Background="{ThemeResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================= Title bar ========================= -->
        <Border
            Grid.Row="0"
            Background="{ThemeResource PanelBrush}"
            BorderBrush="{ThemeResource HairlineBrush}"
            BorderThickness="0,0,0,1">
            <Grid
                x:Name="TopBar"
                Height="{StaticResource TopBarHeight}"
                Padding="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="12"
                    VerticalAlignment="Center">
                    <Border
                        Width="36"
                        Height="36"
                        Background="{ThemeResource AccentSoftBrush}"
                        CornerRadius="12"
                        VerticalAlignment="Center">
                        <Path
                            Data="M12 3 A9 9 0 1 0 12 21 A9 9 0 1 0 12 3 Z M12 7 V13 M12 16 V16.1"
                            Style="{StaticResource IconStyle}"
                            Stroke="{ThemeResource AccentBrush}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                            FontFamily="{StaticResource DisplayFontFamily}"
                            FontSize="{StaticResource FontSizeSubtitle}"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource InkBrush}"
                            Text="ZX0ai" />
                        <TextBlock
                            FontFamily="{StaticResource AppFontFamily}"
                            FontSize="{StaticResource FontSizeCaption}"
                            Foreground="{ThemeResource InkSecondaryBrush}"
                            Text="Modern AI workspace" />
                    </StackPanel>
                </StackPanel>

                <!-- Only the inert middle drags the window. -->
                <Grid
                    x:Name="TitleDragRegion"
                    Grid.Column="1"
                    Background="Transparent" />

                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Center">
                    <Button
                        x:Name="WorkspaceButton"
                        Height="34"
                        Padding="12,0"
                        AutomationProperties.Name="Choose workspace folder"
                        BorderBrush="{ThemeResource HairlineBrush}"
                        BorderThickness="1"
                        Click="OnWorkspaceClick"
                        CornerRadius="{StaticResource RadiusPill}"
                        Style="{StaticResource FlatButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path
                                Data="M3 7 A1 1 0 0 1 4 6 H9 L11 8 H20 A1 1 0 0 1 21 9 V18 A1 1 0 0 1 20 19 H4 A1 1 0 0 1 3 18 Z"
                                Style="{StaticResource IconSmallStyle}" />
                            <TextBlock
                                x:Name="WorkspaceLabel"
                                MaxWidth="180"
                                FontFamily="{StaticResource AppFontFamily}"
                                FontSize="{StaticResource FontSizeCaption}"
                                Foreground="{ThemeResource InkBrush}"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="ThemeButton"
                        AutomationProperties.Name="Switch theme"
                        Click="OnThemeClick"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Switch theme">
                        <Path
                            x:Name="ThemeIcon"
                            Style="{StaticResource IconStyle}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================== Body ============================ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="RailColumn" Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="RunColumn" Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- ====================== Sidebar ==================== -->
            <Border
               x:Name="Rail"
               Grid.Column="0"
               Width="{StaticResource RailWidth}"
               Padding="18"
               Background="{ThemeResource RaisedBrush}"
               BorderBrush="{ThemeResource HairlineBrush}"
               BorderThickness="0,0,1,0">
               <Grid RowSpacing="20">
                   <Grid.RowDefinitions>
                       <RowDefinition Height="Auto" />
                       <RowDefinition Height="Auto" />
                       <RowDefinition Height="Auto" />
                       <RowDefinition Height="Auto" />
                       <RowDefinition Height="*" />
                       <RowDefinition Height="Auto" />
                   </Grid.RowDefinitions>

                   <StackPanel Grid.Row="0" Spacing="6">
                       <TextBlock
                           FontFamily="{StaticResource DisplayFontFamily}"
                           FontSize="{StaticResource FontSizeSubtitle}"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource InkBrush}"
                           Text="ZX0ai" />
                       <TextBlock
                           FontFamily="{StaticResource AppFontFamily}"
                           FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{ThemeResource InkSecondaryBrush}"
                           Text="Modern AI workspace"
                           TextWrapping="Wrap" />
                   </StackPanel>

                   <StackPanel Grid.Row="1" Spacing="8">
                       <Button
                           AutomationProperties.Name="Chat"
                           Click="OnNewChatClick"
                           Style="{StaticResource NavButtonStyle}">
                           <StackPanel Orientation="Horizontal" Spacing="10">
                               <Path
                                   Data="M12 3 A9 9 0 1 0 12 21 A9 9 0 1 0 12 3 Z M8 12 H16 M8 16 H13"
                                   Style="{StaticResource IconSmallStyle}" />
                               <TextBlock
                                   FontFamily="{StaticResource AppFontFamily}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   Foreground="{ThemeResource InkBrush}"
                                   Text="Chat" />
                           </StackPanel>
                       </Button>
                       <Button
                           AutomationProperties.Name="History"
                           Style="{StaticResource NavButtonStyle}">
                           <StackPanel Orientation="Horizontal" Spacing="10">
                               <Path
                                   Data="M11 4 A8 8 0 1 0 11 20 A8 8 0 1 0 11 4 Z M11 7 V12 L14 14"
                                   Style="{StaticResource IconSmallStyle}" />
                               <TextBlock
                                   FontFamily="{StaticResource AppFontFamily}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   Foreground="{ThemeResource InkBrush}"
                                   Text="History" />
                           </StackPanel>
                       </Button>
                       <Button
                           AutomationProperties.Name="Models"
                           Click="OnModelClick"
                           Style="{StaticResource NavButtonStyle}">
                           <StackPanel Orientation="Horizontal" Spacing="10">
                               <Path
                                   Data="M5 7 H19 M5 12 H19 M5 17 H13"
                                   Style="{StaticResource IconSmallStyle}" />
                               <TextBlock
                                   FontFamily="{StaticResource AppFontFamily}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   Foreground="{ThemeResource InkBrush}"
                                   Text="Models" />
                           </StackPanel>
                       </Button>
                       <Button
                           AutomationProperties.Name="Files"
                           Click="OnDockTabClick"
                           Tag="files"
                           Style="{StaticResource NavButtonStyle}">
                           <StackPanel Orientation="Horizontal" Spacing="10">
                               <Path
                                   Data="M4 7 H20 V17 H4 Z M4 11 H20"
                                   Style="{StaticResource IconSmallStyle}" />
                               <TextBlock
                                   FontFamily="{StaticResource AppFontFamily}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   Foreground="{ThemeResource InkBrush}"
                                   Text="Files" />
                           </StackPanel>
                       </Button>
                       <Button
                           AutomationProperties.Name="Settings"
                           Click="OnHelpClick"
                           Style="{StaticResource NavButtonStyle}">
                           <StackPanel Orientation="Horizontal" Spacing="10">
                               <Path
                                   Data="M12 5 A7 7 0 1 0 12 19 A7 7 0 1 0 12 5 Z M12 9 V12 M12 15 V15.1"
                                   Style="{StaticResource IconSmallStyle}" />
                               <TextBlock
                                   FontFamily="{StaticResource AppFontFamily}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   Foreground="{ThemeResource InkBrush}"
                                   Text="Settings" />
                           </StackPanel>
                       </Button>
                   </StackPanel>

                   <Border
                       Grid.Row="2"
                       Padding="12"
                       Background="{ThemeResource SunkenBrush}"
                       CornerRadius="{StaticResource RadiusSmall}">
                       <Grid ColumnSpacing="10">
                           <Grid.ColumnDefinitions>
                               <ColumnDefinition Width="Auto" />
                               <ColumnDefinition Width="*" />
                           </Grid.ColumnDefinitions>
                           <Path
                               Grid.Column="0"
                               Data="M11 4 A7 7 0 1 0 11 18 A7 7 0 1 0 11 4 Z M16.2 16.2 L21 21"
                               Style="{StaticResource IconSmallStyle}" />
                           <TextBox
                               x:Name="SearchBox"
                               Grid.Column="1"
                               FontSize="{StaticResource FontSizeCaption}"
                               PlaceholderText="Search chats"
                               Style="{StaticResource BareTextBoxStyle}"
                               TextChanged="OnSearchChanged"
                               VerticalAlignment="Center" />
                       </Grid>
                   </Border>

                   <TextBlock
                       Grid.Row="3"
                       Style="{StaticResource SidebarSectionHeaderStyle}"
                       Text="Your chats" />

                   <ScrollViewer
                       Grid.Row="4"
                       HorizontalScrollMode="Disabled"
                       VerticalScrollBarVisibility="Auto"
                       VerticalScrollMode="Auto">
                       <StackPanel Spacing="12">
                           <ItemsControl x:Name="HistoryList">
                               <ItemsControl.ItemTemplate>
                                   <DataTemplate x:DataType="vm:HistoryRow">
                                       <Grid Margin="0,0,0,2">
                                           <Border
                                               Background="{ThemeResource SelectedBrush}"
                                               BorderBrush="{ThemeResource HairlineBrush}"
                                               BorderThickness="1"
                                               CornerRadius="{StaticResource RadiusSmall}"
                                               Visibility="{x:Bind SelectionVisibility}" />
                                           <Button
                                               AutomationProperties.Name="{x:Bind Title}"
                                               Click="OnHistoryRowClick"
                                               Style="{StaticResource RowButtonStyle}"
                                               Tag="{x:Bind Id}">
                                               <Grid ColumnSpacing="8">
                                                   <Grid.ColumnDefinitions>
                                                       <ColumnDefinition Width="*" />
                                                       <ColumnDefinition Width="Auto" />
                                                   </Grid.ColumnDefinitions>
                                                   <TextBlock
                                                       Grid.Column="0"
                                                       Style="{StaticResource RowTextStyle}"
                                                       Text="{x:Bind Title}" />
                                                   <TextBlock
                                                       Grid.Column="1"
                                                       FontFamily="{StaticResource AppFontFamily}"
                                                       FontSize="{StaticResource FontSizeMicro}"
                                                       Foreground="{ThemeResource InkTertiaryBrush}"
                                                       Text="{x:Bind Age}"
                                                       VerticalAlignment="Center" />
                                               </Grid>
                                           </Button>
                                       </Grid>
                                   </DataTemplate>
                               </ItemsControl.ItemTemplate>
                           </ItemsControl>

                           <!-- Shown only when nothing has been saved yet. -->
                           <TextBlock
                               x:Name="HistoryEmpty"
                               Style="{StaticResource SectionCaptionTextStyle}"
                               Text="No conversations yet."
                               TextWrapping="Wrap" />

                           <TextBlock
                               Style="{StaticResource SidebarSectionHeaderStyle}"
                               Text="Workspaces" />
                           <panels:ProjectsPanel x:Name="RailProjects" />
                       </StackPanel>
                   </ScrollViewer>

                   <!-- Footer: the signed-in name. -->
                   <Grid
                       Grid.Row="5"
                       Height="40"
                       ColumnSpacing="{StaticResource Space200}">
                       <Grid.ColumnDefinitions>
                           <ColumnDefinition Width="Auto" />
                           <ColumnDefinition Width="*" />
                           <ColumnDefinition Width="Auto" />
                       </Grid.ColumnDefinitions>

                       <Grid Grid.Column="0" Width="32" Height="32">
                           <Ellipse Fill="{ThemeResource AccentBrush}" />
                           <TextBlock
                               x:Name="UserInitial"
                               FontFamily="{StaticResource AppFontFamily}"
                               FontSize="{StaticResource FontSizeCaption}"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource InkOnAccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                       </Grid>

                       <TextBlock
                           x:Name="UserName"
                           Grid.Column="1"
                           FontFamily="{StaticResource AppFontFamily}"
                           FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{ThemeResource InkBrush}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />

                       <Button
                           Grid.Column="2"
                           Width="32"
                           Height="32"
                           AutomationProperties.Name="About ZX0ai"
                           Click="OnHelpClick"
                           Style="{StaticResource IconButtonStyle}"
                           ToolTipService.ToolTip="About">
                           <Path
                               Data="M12 3 A9 9 0 1 0 12 21 A9 9 0 1 0 12 3 Z M10.2 9.3 A1.8 1.8 0 1 1 12.7 11.4 C12 12 11.7 12.4 11.7 13.2 M11.7 15.8 V15.9"
                               Style="{StaticResource IconSmallStyle}" />
                       </Button>
                   </Grid>
               </Grid>
            </Border>

            <!-- ==================== Conversation ====================== -->
            <Grid Grid.Column="1" Background="{ThemeResource CanvasBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid
                    Grid.Row="0"
                    Height="46"
                    Padding="14,0">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                        <Path
                            Data="M4 6 A2 2 0 0 1 6 4 H18 A2 2 0 0 1 20 6 V15 A2 2 0 0 1 18 17 H9 L5 20 V17 A1 1 0 0 1 4 16 Z"
                            Style="{StaticResource IconSmallStyle}" />
                        <TextBlock
                            x:Name="ConversationTitle"
                            MaxWidth="420"
                            FontFamily="{StaticResource AppFontFamily}"
                            FontSize="{StaticResource FontSizeSmall}"
                            Foreground="{ThemeResource InkBrush}"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                        <Button
                            x:Name="DeleteChatButton"
                            AutomationProperties.Name="Delete conversation"
                            Click="OnDeleteChatClick"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="Delete conversation">
                            <Path
                                Data="M5 7 H19 M10 7 V5 H14 V7 M6.5 7 L7.5 20 H16.5 L17.5 7"
                                Style="{StaticResource IconStyle}" />
                        </Button>
                        <Button
                            AutomationProperties.Name="Run panel (Ctrl+Shift+R)"
                            Click="OnToggleRunPanelClick"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="Run panel (Ctrl+Shift+R)">
                            <Path
                                Data="M4 5 H20 A1 1 0 0 1 21 6 V18 A1 1 0 0 1 20 19 H4 A1 1 0 0 1 3 18 V6 A1 1 0 0 1 4 5 Z M15 5 V19"
                                Style="{StaticResource IconStyle}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- The question behind, the transcript in front, the composer over both. -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <controls:HeroText
                        x:Name="Hero"
                        ComposerGap="112"
                        Ink="{ThemeResource HeroInkBrush}"
                        Grid.Row="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Margin="32,32,32,0" />

                    <ListView
                        x:Name="ThreadListView"
                        Grid.Row="0"
                        SelectionMode="None"
                        IsItemClickEnabled="False"
                        Margin="0"
                        Padding="0"
                        MaxWidth="860"
                        HorizontalAlignment="Center"
                        ScrollViewer.HorizontalScrollMode="Disabled"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ItemContainerStyle="{StaticResource MessageListItemStyle}"
                        Visibility="Collapsed">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ChatMessage">
                                <StackPanel Spacing="14">
                                    <!-- Assistant: render markdown inline, no surrounding card -->
                                    <controls:MarkdownView
                                        Visibility="{x:Bind Role, Converter={StaticResource RoleToVisibilityConverter}, ConverterParameter=Assistant}"
                                        Text="{x:Bind Content, Mode=OneWay}"
                                        MaxWidth="860"
                                        HorizontalAlignment="Left" />

                                    <!-- User: plain flowing text aligned right, no bubble/card -->
                                    <TextBlock
                                        Visibility="{x:Bind Role, Converter={StaticResource RoleToVisibilityConverter}, ConverterParameter=User}"
                                        Text="{x:Bind Content, Mode=OneWay}"
                                        Style="{StaticResource AssistantTextStyle}"
                                        TextWrapping="Wrap"
                                        MaxWidth="860"
                                        HorizontalAlignment="Right" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!--
                        The composer floats over the surface in both states: centred under
                        the question while the conversation is empty, pinned to the foot of
                        the transcript once it is not. It is one element that changes
                        alignment rather than two that swap, so focus and any typed text
                        survive the transition.
                    -->
                    <Grid
                        x:Name="ComposerHost"
                        Grid.Row="1"
                        MaxWidth="860"
                        Margin="32,0,32,22"
                        HorizontalAlignment="Center">
                        <StackPanel Spacing="14">

                            <!--
                                Where a message actually goes: the bound folder, where
                                it runs, and — when the folder is a git repository — the
                                branch it will land on. Hidden with no folder bound,
                                since none of the three has an answer yet.
                            -->
                            <StackPanel
                                x:Name="Breadcrumb"
                                Margin="4,0,4,0"
                                Orientation="Horizontal"
                                Spacing="{StaticResource Space150}"
                                Visibility="Collapsed">
                                <Path
                                    Data="M3 7 A1 1 0 0 1 4 6 H9 L11 8 H20 A1 1 0 0 1 21 9 V18 A1 1 0 0 1 20 19 H4 A1 1 0 0 1 3 18 Z"
                                    Style="{StaticResource IconSmallStyle}" />
                                <TextBlock
                                    x:Name="BreadcrumbProject"
                                    FontFamily="{StaticResource AppFontFamily}"
                                    FontSize="{StaticResource FontSizeMicro}"
                                    Foreground="{ThemeResource InkSecondaryBrush}"
                                    MaxWidth="160"
                                    TextTrimming="CharacterEllipsis"
                                    VerticalAlignment="Center" />

                                <Border Width="1" Height="12" Background="{ThemeResource HairlineStrongBrush}" />
                                <Path
                                    Data="M4 5 H20 A1 1 0 0 1 21 6 V15 A1 1 0 0 1 20 16 H4 A1 1 0 0 1 3 15 V6 A1 1 0 0 1 4 5 Z M9 20 H15 M12 16 V20"
                                    Style="{StaticResource IconSmallStyle}" />
                                <TextBlock
                                    FontFamily="{StaticResource MonoFontFamily}"
                                    FontSize="{StaticResource FontSizeMicro}"
                                    Foreground="{ThemeResource InkSecondaryBrush}"
                                    Text="Local"
                                    VerticalAlignment="Center" />

                                <StackPanel
                                    x:Name="BreadcrumbBranchSegment"
                                    Orientation="Horizontal"
                                    Spacing="{StaticResource Space150}"
                                    Visibility="Collapsed">
                                    <Border Width="1" Height="12" Background="{ThemeResource HairlineStrongBrush}" />
                                    <Path
                                        Data="M7 4 A2 2 0 1 0 7 4.01 Z M7 6 V18 M7 18 A2 2 0 1 0 7 18.01 Z M17 8 A2 2 0 1 0 17 8.01 Z M17 8 C17 11 14 11 11 11 C9 11 7 11 7 9"
                                        Style="{StaticResource IconSmallStyle}" />
                                    <TextBlock
                                        x:Name="BreadcrumbBranch"
                                        FontFamily="{StaticResource MonoFontFamily}"
                                        FontSize="{StaticResource FontSizeMicro}"
                                        Foreground="{ThemeResource InkSecondaryBrush}"
                                        MaxWidth="180"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>

                            <!-- A real failure, in the user's terms. Hidden when there is none. -->
                            <Border
                                x:Name="ErrorBanner"
                                Padding="12,10"
                                Background="{ThemeResource RaisedBrush}"
                                BorderBrush="{ThemeResource HairlineStrongBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSmall}"
                                Visibility="Collapsed">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path
                                        Grid.Column="0"
                                        Data="M12 3 A9 9 0 1 0 12 21 A9 9 0 1 0 12 3 Z M12 7 V13 M12 16 V16.1"
                                        Stroke="{ThemeResource InkBrush}"
                                        Style="{StaticResource IconSmallStyle}"
                                        VerticalAlignment="Top" />
                                    <TextBlock
                                        x:Name="ErrorText"
                                        Grid.Column="1"
                                        FontFamily="{StaticResource AppFontFamily}"
                                        FontSize="{StaticResource FontSizeCaption}"
                                        Foreground="{ThemeResource InkBrush}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </Border>

                            <Border
                                Padding="16"
                                Background="{ThemeResource RaisedBrush}"
                                BorderBrush="{ThemeResource HairlineBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusPanel}">
                                <StackPanel Spacing="14">
                                    <TextBox
                                        x:Name="Prompt"
                                        Margin="0"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        MinHeight="76"
                                        MaxHeight="200"
                                        KeyDown="OnPromptKeyDown"
                                        TextChanged="OnPromptTextChanged"
                                        PlaceholderText="Ask anything — Shift+Enter for a new line"
                                        AutomationProperties.Name="Message"
                                        AutomationProperties.HelpText="Type your message here. Press Enter to send, or Shift+Enter for a new line."
                                        Style="{StaticResource BareTextBoxStyle}" />

                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" ColumnSpacing="12">
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                            <Button
                                                x:Name="AddButton"
                                                AutomationProperties.Name="Add"
                                                Click="OnAddClick"
                                                Style="{StaticResource IconButtonStyle}"
                                                ToolTipService.ToolTip="Add">
                                                <Path
                                                    Data="M12 5 V19 M5 12 H19"
                                                    Style="{StaticResource IconStyle}" />
                                            </Button>
                                            <Button
                                                x:Name="DictateButton"
                                                AutomationProperties.Name="Dictate"
                                                Style="{StaticResource IconButtonStyle}"
                                                ToolTipService.ToolTip="Dictation is not wired yet">
                                                <Path
                                                    Data="M12 4 A3 3 0 0 0 9 7 V12 A3 3 0 0 0 15 12 V7 A3 3 0 0 0 12 4 Z M5.5 11 V12 A6.5 6.5 0 0 0 18.5 12 V11 M12 18.5 V21"
                                                    Style="{StaticResource IconStyle}" />
                                            </Button>
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="10"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                            <Button
                                                x:Name="AccessButton"
                                                Height="34"
                                                Padding="12,0"
                                                AutomationProperties.Name="Access mode"
                                                Click="OnAccessClick"
                                                CornerRadius="{StaticResource RadiusPill}"
                                                Style="{StaticResource FlatButtonStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Path
                                                        x:Name="AccessIcon"
                                                        Style="{StaticResource IconSmallStyle}" />
                                                    <TextBlock
                                                        x:Name="AccessLabel"
                                                        FontFamily="{StaticResource AppFontFamily}"
                                                        FontSize="{StaticResource FontSizeCaption}"
                                                        VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                x:Name="ModelButton"
                                                Height="34"
                                                Padding="12,0"
                                                AutomationProperties.Name="Model"
                                                Click="OnModelClick"
                                                CornerRadius="{StaticResource RadiusPill}"
                                                Style="{StaticResource FlatButtonStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock
                                                        x:Name="ModelChip"
                                                        FontFamily="{StaticResource AppFontFamily}"
                                                        FontSize="{StaticResource FontSizeCaption}"
                                                        Foreground="{ThemeResource InkBrush}"
                                                        VerticalAlignment="Center" />
                                                    <TextBlock
                                                        x:Name="EffortChip"
                                                        FontFamily="{StaticResource AppFontFamily}"
                                                        FontSize="{StaticResource FontSizeCaption}"
                                                        Foreground="{ThemeResource AccentInkBrush}"
                                                        VerticalAlignment="Center" />
                                                    <Path
                                                        Data="M6 9 L12 15 L18 9"
                                                        Style="{StaticResource IconSmallStyle}" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>

                                        <Button
                                            Grid.Column="2"
                                            x:Name="SendButton"
                                            Width="44"
                                            Height="44"
                                            AutomationProperties.Name="Send"
                                            AutomationProperties.HelpText="Send the current message or stop streaming when a turn is running."
                                            Background="{ThemeResource AccentBrush}"
                                            Click="OnSendClick"
                                            CornerRadius="22"
                                            Style="{StaticResource FlatButtonStyle}"
                                            ToolTipService.ToolTip="Send">
                                            <Button.KeyboardAccelerators>
                                                <KeyboardAccelerator Key="Enter" Modifiers="Control" Invoked="OnSendKeyboardAccelerator"/>
                                            </Button.KeyboardAccelerators>
                                            <Path
                                                x:Name="SendIcon"
                                                Width="16"
                                                Height="16"
                                                Data="M12 19 V5 M5.5 11.5 L12 5 L18.5 11.5"
                                                Style="{StaticResource IconOnAccentStyle}" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>            </Grid>

            <!-- ======================== Run panel ===================== -->
            <Border
                x:Name="RunPanel"
                Grid.Column="2"
                Width="{StaticResource ToolPanelWidth}"
                Padding="12"
                Background="{ThemeResource PanelBrush}"
                BorderBrush="{ThemeResource HairlineBrush}"
                BorderThickness="1,0,0,0">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" RowSpacing="{StaticResource Space200}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Height="28">
                            <TextBlock
                                x:Name="DockTitle"
                                FontFamily="{StaticResource AppFontFamily}"
                                FontSize="{StaticResource FontSizeSmall}"
                                Foreground="{ThemeResource InkBrush}"
                                VerticalAlignment="Center" />
                            <Button
                                Width="28"
                                Height="28"
                                HorizontalAlignment="Right"
                                AutomationProperties.Name="Close panel (Ctrl+Shift+R)"
                                Click="OnToggleRunPanelClick"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTipService.ToolTip="Close panel (Ctrl+Shift+R)">
                                <Path
                                    Data="M6 6 L18 18 M18 6 L6 18"
                                    Style="{StaticResource IconSmallStyle}" />
                            </Button>
                        </Grid>

                        <!-- One dock, three views of the same workspace. -->
                        <Border
                            Grid.Row="1"
                            Height="32"
                            Padding="3"
                            Background="{ThemeResource SunkenBrush}"
                            CornerRadius="{StaticResource RadiusPill}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    x:Name="RunTabButton"
                                    Grid.Column="0"
                                    AutomationProperties.Name="Run"
                                    Click="OnDockTabClick"
                                    Style="{StaticResource TabStyle}"
                                    Tag="run"
                                    ToolTipService.ToolTip="Run">
                                    <Path
                                        x:Name="RunTabIcon"
                                        Data="M3 12 H8 L10 6 L14 18 L16 12 H21"
                                        Style="{StaticResource TabIconStyle}" />
                                </Button>
                                <Button
                                    x:Name="TerminalTabButton"
                                    Grid.Column="1"
                                    AutomationProperties.Name="Terminal"
                                    Click="OnDockTabClick"
                                    Style="{StaticResource TabStyle}"
                                    Tag="terminal"
                                    ToolTipService.ToolTip="Terminal">
                                    <Path
                                        x:Name="TerminalTabIcon"
                                        Data="M4 6 A1 1 0 0 1 5 5 H19 A1 1 0 0 1 20 6 V18 A1 1 0 0 1 19 19 H5 A1 1 0 0 1 4 18 Z M7.5 10 L10.5 12.5 L7.5 15 M12.5 15 H16"
                                        Style="{StaticResource TabIconStyle}" />
                                </Button>
                                <Button
                                    x:Name="FilesTabButton"
                                    Grid.Column="2"
                                    AutomationProperties.Name="Files"
                                    Click="OnDockTabClick"
                                    Style="{StaticResource TabStyle}"
                                    Tag="files"
                                    ToolTipService.ToolTip="Files">
                                    <Path
                                        x:Name="FilesTabIcon"
                                        Data="M3 7 A1 1 0 0 1 4 6 H9 L11 8 H20 A1 1 0 0 1 21 9 V18 A1 1 0 0 1 20 19 H4 A1 1 0 0 1 3 18 Z"
                                        Style="{StaticResource TabIconStyle}" />
                                </Button>
                                <Button
                                    x:Name="ActivityTabButton"
                                    Grid.Column="3"
                                    AutomationProperties.Name="Activity"
                                    Click="OnDockTabClick"
                                    Style="{StaticResource TabStyle}"
                                    Tag="activity"
                                    ToolTipService.ToolTip="Activity">
                                    <Path
                                        x:Name="ActivityTabIcon"
                                        Data="M12 3 A9 9 0 1 0 12 21 A9 9 0 1 0 12 3 Z M9 12 H15"
                                        Style="{StaticResource TabIconStyle}" />
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>

                    <!--
                        Measured facts about the turn that ran, and nothing else. Every
                        value here was observed: the state came from the stream, the rate
                        from characters over elapsed time, the model from the request that
                        was sent. Before the first turn the panel is empty and says so.
                    -->
                    <Grid Grid.Row="1">
                        <StackPanel x:Name="RunView" Spacing="14">

                        <!--
                            The orb lives here rather than on the conversation surface.
                            It is the one object in the product allowed colour, and on the
                            empty state it competed with the question it was sitting on
                            top of. In the panel it has room, it is present in both states,
                            and it is visibly turning while a turn streams.
                        -->
                        <controls:OrbControl
                            x:Name="Orb"
                            Width="150"
                            Height="150"
                            HorizontalAlignment="Center" />

                        <StackPanel x:Name="RunDetail" Spacing="10">
                            <StackPanel Spacing="3">
                                <TextBlock Style="{StaticResource SectionCaptionTextStyle}" Text="STATUS" />
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Ellipse
                                        x:Name="RunDot"
                                        Width="7"
                                        Height="7"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        x:Name="RunStatus"
                                        FontFamily="{StaticResource AppFontFamily}"
                                        FontSize="{StaticResource FontSizeSmall}"
                                        Foreground="{ThemeResource InkBrush}"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="3">
                                <TextBlock Style="{StaticResource SectionCaptionTextStyle}" Text="MODEL" />
                                <TextBlock
                                    x:Name="RunModel"
                                    FontFamily="{StaticResource MonoFontFamily}"
                                    FontSize="{StaticResource FontSizeMicro}"
                                    Foreground="{ThemeResource InkSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Style="{StaticResource SectionCaptionTextStyle}" Text="TOKENS" />
                                    <TextBlock
                                        x:Name="RunTokens"
                                        FontFamily="{StaticResource MonoFontFamily}"
                                        FontSize="{StaticResource FontSizeSmall}"
                                        Foreground="{ThemeResource InkBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Style="{StaticResource SectionCaptionTextStyle}" Text="RATE" />
                                    <TextBlock
                                        x:Name="RunRate"
                                        FontFamily="{StaticResource MonoFontFamily}"
                                        FontSize="{StaticResource FontSizeSmall}"
                                        Foreground="{ThemeResource InkBrush}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="3">
                                <TextBlock Style="{StaticResource SectionCaptionTextStyle}" Text="ELAPSED" />
                                <TextBlock
                                    x:Name="RunElapsed"
                                    FontFamily="{StaticResource MonoFontFamily}"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    Foreground="{ThemeResource InkBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <!--
                            Real tool executions for the current turn: what was called,
                            with what, and whether it worked. This is an audit trail, not
                            a progress animation — every row corresponds to a file that
                            was read or written, or a command that actually ran.
                        -->
                        <StackPanel x:Name="ToolSection" Spacing="6">
                            <TextBlock Style="{StaticResource SectionCaptionTextStyle}" Text="TOOL EXECUTION" />
                            <ItemsControl x:Name="ToolList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="services:ToolRun">
                                        <Border
                                            Margin="0,0,0,4"
                                            Padding="9,7"
                                            Background="{ThemeResource SunkenBrush}"
                                            CornerRadius="{StaticResource RadiusSmall}">
                                            <StackPanel Spacing="3">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <Ellipse
                                                        Width="6"
                                                        Height="6"
                                                        Fill="{ThemeResource AccentBrush}"
                                                        VerticalAlignment="Center" />
                                                    <TextBlock
                                                        FontFamily="{StaticResource MonoFontFamily}"
                                                        FontSize="{StaticResource FontSizeMicro}"
                                                        Foreground="{ThemeResource InkBrush}"
                                                        Text="{x:Bind Name}"
                                                        VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock
                                                    Style="{StaticResource SectionCaptionTextStyle}"
                                                    Text="{x:Bind Arguments}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock
                            x:Name="RunEmpty"
                            Style="{StaticResource SectionCaptionTextStyle}"
                            Text="Nothing has run yet."
                            TextWrapping="Wrap" />

                        <!-- Credential state. Presence only; no key is ever shown. -->
                        <Border
                            x:Name="CredentialNotice"
                            Padding="10,8"
                            Background="{ThemeResource SunkenBrush}"
                            CornerRadius="{StaticResource RadiusSmall}"
                            Visibility="Collapsed">
                            <TextBlock
                                Style="{StaticResource SectionCaptionTextStyle}"
                                Text="No credential found for this capability. Set its key and restart."
                                TextWrapping="Wrap" />
                        </Border>
                        </StackPanel>

                        <panels:TerminalPanel x:Name="TerminalView" Visibility="Collapsed" />
                        <panels:FilesPanel x:Name="FilesView" Visibility="Collapsed" />
                        <controls:ActivityTimelineView x:Name="ActivityView" Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
