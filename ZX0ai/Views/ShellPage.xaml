<Page
    x:Class="ZX0ai.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ZX0ai.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:ZX0ai.Services"
    xmlns:local="using:ZX0ai.Views"
    xmlns:panels="using:ZX0ai.Views.Panels"
    xmlns:vm="using:ZX0ai.ViewModels"
    xmlns:models="using:ZX0ai.Core.Models"
    mc:Ignorable="d"
    SizeChanged="OnRootSizeChanged">

    <Page.Resources>
        <local:ChatRoleToVisibilityConverter x:Key="RoleToVisibilityConverter" />
    </Page.Resources>

    <!--
        Three regions, left to right: the conversations that exist, the one that is open,
        and what the open one is doing. Everything rendered here comes from real state —
        the rail lists files on disk, the model chip names the slug that will be called,
        and the run panel reports a turn that happened. There is no sample content, so an
        empty product looks empty.
    -->

    <Grid x:Name="RootGrid" Background="{ThemeResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================= Title bar ========================= -->
        <Border
            Grid.Row="0"
            Background="{ThemeResource PanelBrush}"
            BorderBrush="{ThemeResource HairlineBrush}"
            BorderThickness="0,0,0,1">
            <Grid
                x:Name="TopBar"
                Height="{StaticResource TopBarHeight}"
                Padding="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="12"
                    VerticalAlignment="Center">
                    <Border
                        Width="36"
                        Height="36"
                        Background="{ThemeResource AccentSoftBrush}"
                        CornerRadius="12"
                        VerticalAlignment="Center">
                        <Path
                            Data="M12 3 A9 9 0 1 0 12 21 A9 9 0 1 0 12 3 Z M12 7 V13 M12 16 V16.1"
                            Style="{StaticResource IconStyle}"
                            Stroke="{ThemeResource AccentBrush}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                            FontFamily="{StaticResource DisplayFontFamily}"
                            FontSize="{StaticResource FontSizeSubtitle}"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource InkBrush}"
                            Text="ZX0ai" />
                        <TextBlock
                            FontFamily="{StaticResource AppFontFamily}"
                            FontSize="{StaticResource FontSizeCaption}"
                            Foreground="{ThemeResource InkSecondaryBrush}"
                            Text="Modern AI workspace" />
                    </StackPanel>
                </StackPanel>

                <!-- Only the inert middle drags the window. -->
                <Grid
                    x:Name="TitleDragRegion"
                    Grid.Column="1"
                    Background="Transparent" />

                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Center">
                    <Button
                        x:Name="WorkspaceButton"
                        Height="34"
                        Padding="12,0"
                        AutomationProperties.Name="Choose workspace folder"
                        BorderBrush="{ThemeResource HairlineBrush}"
                        BorderThickness="1"
                        Click="OnWorkspaceClick"
                        CornerRadius="{StaticResource RadiusPill}"
                        Style="{StaticResource FlatButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path
                                Data="M3 7 A1 1 0 0 1 4 6 H9 L11 8 H20 A1 1 0 0 1 21 9 V18 A1 1 0 0 1 20 19 H4 A1 1 0 0 1 3 18 Z"
                                Style="{StaticResource IconSmallStyle}" />
                            <TextBlock
                                x:Name="WorkspaceLabel"
                                MaxWidth="180"
                                FontFamily="{StaticResource AppFontFamily}"
                                FontSize="{StaticResource FontSizeCaption}"
                                Foreground="{ThemeResource InkBrush}"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="ThemeButton"
                        AutomationProperties.Name="Switch theme"
                        Click="OnThemeClick"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="Switch theme">
                        <Path
                            x:Name="ThemeIcon"
                            Style="{StaticResource IconStyle}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================== Body ============================ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="RailColumn" Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="RunColumn" Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- ====================== Sidebar ==================== -->
            <Border
               x:Name="Rail"
               Grid.Column="0"
               Width="{StaticResource RailWidth}"
               Padding="18"
               Background="{ThemeResource RaisedBrush}"
               BorderBrush="{ThemeResource HairlineBrush}"
               BorderThickness="0,0,1,0">
               <Grid RowSpacing="14">
                   <Grid.RowDefinitions>
                       <RowDefinition Height="Auto" />
                       <RowDefinition Height="Auto" />
                       <RowDefinition Height="*" />
                   </Grid.RowDefinitions>

                   <!-- Projects header with collapse + new-chat -->
                   <Grid Grid.Row="0" ColumnSpacing="8">
                       <Grid.ColumnDefinitions>
                           <ColumnDefinition Width="*" />
                           <ColumnDefinition Width="Auto" />
                           <ColumnDefinition Width="Auto" />
                       </Grid.ColumnDefinitions>
                       <TextBlock
                           Grid.Column="0"
                           FontFamily="{StaticResource DisplayFontFamily}"
                           FontSize="{StaticResource FontSizeSmall}"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource InkBrush}"
                           Text="Projects"
                           VerticalAlignment="Center" />
                       <Button
                           Grid.Column="1"
                           Width="28"
                           Height="28"
                           AutomationProperties.Name="New chat"
                           Click="OnNewChatClick"
                           Style="{StaticResource IconButtonStyle}"
                           ToolTipService.ToolTip="New chat (Ctrl+N)">
                           <Path
                               Data="M12 5 V19 M5 12 H19"
                               Style="{StaticResource IconSmallStyle}" />
                       </Button>
                       <Button
                           Grid.Column="2"
                           Width="28"
                           Height="28"
                           AutomationProperties.Name="Collapse sidebar"
                           Click="OnCollapseRailClick"
                           Style="{StaticResource IconButtonStyle}"
                           ToolTipService.ToolTip="Collapse sidebar">
                           <Path
                               Data="M15 6 L9 12 L15 18"
                               Style="{StaticResource IconSmallStyle}" />
                       </Button>
                   </Grid>

                   <!-- Search field -->
                   <Border
                       Grid.Row="1"
                       Padding="10,6"
                       Background="{ThemeResource SunkenBrush}"
                       BorderBrush="{ThemeResource HairlineBrush}"
                       BorderThickness="1"
                       CornerRadius="{StaticResource RadiusSearch}">
                       <Grid ColumnSpacing="8">
                           <Grid.ColumnDefinitions>
                               <ColumnDefinition Width="Auto" />
                               <ColumnDefinition Width="*" />
                           </Grid.ColumnDefinitions>
                           <Path
                               Grid.Column="0"
                               Data="M11 4 A7 7 0 1 0 11 18 A7 7 0 1 0 11 4 Z M16.2 16.2 L21 21"
                               Style="{StaticResource IconSmallStyle}"
                               Opacity="0.5" />
                           <TextBox
                               x:Name="SearchBox"
                               Grid.Column="1"
                               FontSize="{StaticResource FontSizeCaption}"
                               PlaceholderText="Search..."
                               Style="{StaticResource BareTextBoxStyle}"
                               TextChanged="OnSearchChanged"
                               VerticalAlignment="Center" />
                       </Grid>
                   </Border>

                   <!-- Projects list with nested chats -->
                   <ScrollViewer
                       Grid.Row="2"
                       HorizontalScrollMode="Disabled"
                       VerticalScrollBarVisibility="Auto"
                       VerticalScrollMode="Auto">
                       <StackPanel Spacing="12">
                           <panels:ProjectsPanel x:Name="RailProjects" />
                           <TextBlock
                               x:Name="HistoryEmpty"
                               Style="{StaticResource SectionCaptionTextStyle}"
                               Text="No projects yet. Open a folder to begin."
                               TextWrapping="Wrap" />
                       </StackPanel>
                   </ScrollViewer>
               </Grid>
            </Border>

            <!-- ==================== Conversation ====================== -->
            <Grid Grid.Column="1" Background="{ThemeResource CanvasBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid
                    Grid.Row="0"
                    Height="46"
                    Padding="14,0">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                        <Path
                            Data="M4 6 A2 2 0 0 1 6 4 H18 A2 2 0 0 1 20 6 V15 A2 2 0 0 1 18 17 H9 L5 20 V17 A1 1 0 0 1 4 16 Z"
                            Style="{StaticResource IconSmallStyle}" />
                        <TextBlock
                            x:Name="ConversationTitle"
                            MaxWidth="420"
                            FontFamily="{StaticResource AppFontFamily}"
                            FontSize="{StaticResource FontSizeSmall}"
                            Foreground="{ThemeResource InkBrush}"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                        <Button
                            x:Name="DeleteChatButton"
                            AutomationProperties.Name="Delete conversation"
                            Click="OnDeleteChatClick"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="Delete conversation">
                            <Path
                                Data="M5 7 H19 M10 7 V5 H14 V7 M6.5 7 L7.5 20 H16.5 L17.5 7"
                                Style="{StaticResource IconStyle}" />
                        </Button>
                        <Button
                            AutomationProperties.Name="Run panel (Ctrl+Shift+R)"
                            Click="OnToggleRunPanelClick"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="Run panel (Ctrl+Shift+R)">
                            <Path
                                Data="M4 5 H20 A1 1 0 0 1 21 6 V18 A1 1 0 0 1 20 19 H4 A1 1 0 0 1 3 18 V6 A1 1 0 0 1 4 5 Z M15 5 V19"
                                Style="{StaticResource IconStyle}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- The question behind, the transcript in front, the composer over both. -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <controls:HeroText
                        x:Name="Hero"
                        ComposerGap="112"
                        Ink="{ThemeResource HeroInkBrush}"
                        Grid.Row="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Margin="32,32,32,0" />

                    <ListView
                        x:Name="ThreadListView"
                        Grid.Row="0"
                        SelectionMode="None"
                        IsItemClickEnabled="False"
                        Margin="0"
                        Padding="0"
                        MaxWidth="860"
                        HorizontalAlignment="Center"
                        ScrollViewer.HorizontalScrollMode="Disabled"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ItemContainerStyle="{StaticResource MessageListItemStyle}"
                        Visibility="Collapsed">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ChatMessage">
                                <StackPanel Spacing="10">
                                    <!-- Assistant metadata line: model alias, state, duration, time -->
                                    <StackPanel
                                        Visibility="{x:Bind Role, Converter={StaticResource RoleToVisibilityConverter}, ConverterParameter=Assistant}"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        Opacity="0.6">
                                        <TextBlock
                                            FontFamily="{StaticResource MonoFontFamily}"
                                            FontSize="{StaticResource FontSizeMicro}"
                                            Foreground="{ThemeResource InkSecondaryBrush}"
                                            Text="ZX0ai" />
                                        <Border Width="1" Height="10" Background="{ThemeResource HairlineStrongBrush}" />
                                        <TextBlock
                                            FontFamily="{StaticResource MonoFontFamily}"
                                            FontSize="{StaticResource FontSizeMicro}"
                                            Foreground="{ThemeResource InkSecondaryBrush}"
                                            Text="{x:Bind TierDisplayName, Mode=OneWay}" />
                                        <Border Width="1" Height="10" Background="{ThemeResource HairlineStrongBrush}" />
                                        <TextBlock
                                            FontFamily="{StaticResource MonoFontFamily}"
                                            FontSize="{StaticResource FontSizeMicro}"
                                            Foreground="{ThemeResource InkTertiaryBrush}"
                                            Text="{x:Bind TimeText, Mode=OneWay}" />
                                    </StackPanel>

                                    <!-- Assistant: render markdown inline, no surrounding card -->
                                    <controls:MarkdownView
                                        Visibility="{x:Bind Role, Converter={StaticResource RoleToVisibilityConverter}, ConverterParameter=Assistant}"
                                        Text="{x:Bind Content, Mode=OneWay}"
                                        MaxWidth="860"
                                        HorizontalAlignment="Left" />

                                    <!-- User: compact bubble aligned right -->
                                    <Border
                                        Visibility="{x:Bind Role, Converter={StaticResource RoleToVisibilityConverter}, ConverterParameter=User}"
                                        Background="{ThemeResource SunkenBrush}"
                                        BorderBrush="{ThemeResource HairlineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusPanel}"
                                        MaxWidth="520"
                                        Padding="12,8"
                                        HorizontalAlignment="Right">
                                        <TextBlock
                                            Text="{x:Bind Content, Mode=OneWay}"
                                            Style="{StaticResource AssistantTextStyle}"
                                            TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!--
                        The composer floats over the surface in both states: centred under
                        the question while the conversation is empty, pinned to the foot of
                        the transcript once it is not. It is one element that changes
                        alignment rather than two that swap, so focus and any typed text
                        survive the transition.
                    -->
                    <Grid
                        x:Name="ComposerHost"
                        Grid.Row="1"
                        MaxWidth="860"
                        Margin="32,0,32,22"
                        HorizontalAlignment="Center">
                        <StackPanel Spacing="14">

                            <!--
                                Session strip: current project name + chooser only.
                                No branch, no Local/Cloud, no model, no provider.
                            -->
                            <StackPanel
                                x:Name="Breadcrumb"
                                Margin="4,0,4,0"
                                Orientation="Horizontal"
                                Spacing="{StaticResource Space150}"
                                Visibility="Collapsed">
                                <Path
                                    Data="M3 7 A1 1 0 0 1 4 6 H9 L11 8 H20 A1 1 0 0 1 21 9 V18 A1 1 0 0 1 20 19 H4 A1 1 0 0 1 3 18 Z"
                                    Style="{StaticResource IconSmallStyle}" />
                                <Button
                                    x:Name="BreadcrumbProject"
                                    AutomationProperties.Name="Select project"
                                    Click="OnWorkspaceClick"
                                    Style="{StaticResource FlatButtonStyle}"
                                    ToolTipService.ToolTip="Choose project"
                                    Padding="4,2">
                                    <TextBlock
                                        FontFamily="{StaticResource AppFontFamily}"
                                        FontSize="{StaticResource FontSizeMicro}"
                                        Foreground="{ThemeResource InkSecondaryBrush}"
                                        MaxWidth="200"
                                        TextTrimming="CharacterEllipsis" />
                                </Button>
                            </StackPanel>

                            <!-- A real failure, in the user's terms. Hidden when there is none. -->
                            <Border
                                x:Name="ErrorBanner"
                                Padding="12,10"
                                Background="{ThemeResource RaisedBrush}"
                                BorderBrush="{ThemeResource HairlineStrongBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSmall}"
                                Visibility="Collapsed">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path
                                        Grid.Column="0"
                                        Data="M12 3 A9 9 0 1 0 12 21 A9 9 0 1 0 12 3 Z M12 7 V13 M12 16 V16.1"
                                        Stroke="{ThemeResource InkBrush}"
                                        Style="{StaticResource IconSmallStyle}"
                                        VerticalAlignment="Top" />
                                    <TextBlock
                                        x:Name="ErrorText"
                                        Grid.Column="1"
                                        FontFamily="{StaticResource AppFontFamily}"
                                        FontSize="{StaticResource FontSizeCaption}"
                                        Foreground="{ThemeResource InkBrush}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </Border>

                            <Border
                                Padding="16"
                                Background="{ThemeResource RaisedBrush}"
                                BorderBrush="{ThemeResource HairlineBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusPanel}">
                                <StackPanel Spacing="14">
                                    <TextBox
                                        x:Name="Prompt"
                                        Margin="0"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        MinHeight="76"
                                        MaxHeight="200"
                                        KeyDown="OnPromptKeyDown"
                                        TextChanged="OnPromptTextChanged"
                                        PlaceholderText="Ask anything — Shift+Enter for a new line"
                                        AutomationProperties.Name="Message"
                                        AutomationProperties.HelpText="Type your message here. Press Enter to send, or Shift+Enter for a new line."
                                        Style="{StaticResource BareTextBoxStyle}" />

                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" ColumnSpacing="12">
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                            <Button
                                                x:Name="AddButton"
                                                AutomationProperties.Name="Add"
                                                Click="OnAddClick"
                                                Style="{StaticResource IconButtonStyle}"
                                                ToolTipService.ToolTip="Add">
                                                <Path
                                                    Data="M12 5 V19 M5 12 H19"
                                                    Style="{StaticResource IconStyle}" />
                                            </Button>

                                        </StackPanel>

                                        <StackPanel
                                            Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="10"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                            <Button
                                                x:Name="AccessButton"
                                                Height="34"
                                                Padding="12,0"
                                                AutomationProperties.Name="Access mode"
                                                Click="OnAccessClick"
                                                CornerRadius="{StaticResource RadiusPill}"
                                                Style="{StaticResource FlatButtonStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Path
                                                        x:Name="AccessIcon"
                                                        Style="{StaticResource IconSmallStyle}" />
                                                    <TextBlock
                                                        x:Name="AccessLabel"
                                                        FontFamily="{StaticResource AppFontFamily}"
                                                        FontSize="{StaticResource FontSizeCaption}"
                                                        VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                x:Name="ModelButton"
                                                Height="34"
                                                Padding="12,0"
                                                AutomationProperties.Name="Model"
                                                Click="OnModelClick"
                                                CornerRadius="{StaticResource RadiusPill}"
                                                Style="{StaticResource FlatButtonStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock
                                                        x:Name="ModelChip"
                                                        FontFamily="{StaticResource AppFontFamily}"
                                                        FontSize="{StaticResource FontSizeCaption}"
                                                        Foreground="{ThemeResource InkBrush}"
                                                        VerticalAlignment="Center" />
                                                    <TextBlock
                                                        x:Name="EffortChip"
                                                        FontFamily="{StaticResource AppFontFamily}"
                                                        FontSize="{StaticResource FontSizeCaption}"
                                                        Foreground="{ThemeResource AccentInkBrush}"
                                                        VerticalAlignment="Center" />
                                                    <Path
                                                        Data="M6 9 L12 15 L18 9"
                                                        Style="{StaticResource IconSmallStyle}" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>

                                        <Button
                                            Grid.Column="2"
                                            x:Name="SendButton"
                                            Width="44"
                                            Height="44"
                                            AutomationProperties.Name="Send"
                                            AutomationProperties.HelpText="Send the current message or stop streaming when a turn is running."
                                            Background="{ThemeResource AccentBrush}"
                                            Click="OnSendClick"
                                            CornerRadius="22"
                                            Style="{StaticResource FlatButtonStyle}"
                                            ToolTipService.ToolTip="Send">
                                            <Button.KeyboardAccelerators>
                                                <KeyboardAccelerator Key="Enter" Modifiers="Control" Invoked="OnSendKeyboardAccelerator"/>
                                            </Button.KeyboardAccelerators>
                                            <Path
                                                x:Name="SendIcon"
                                                Width="16"
                                                Height="16"
                                                Data="M12 19 V5 M5.5 11.5 L12 5 L18.5 11.5"
                                                Style="{StaticResource IconOnAccentStyle}" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>            </Grid>

            <!-- ======================== Run panel ===================== -->
            <Border
                x:Name="RunPanel"
                Grid.Column="2"
                Width="{StaticResource ToolPanelWidth}"
                Padding="12"
                Background="{ThemeResource PanelBrush}"
                BorderBrush="{ThemeResource HairlineBrush}"
                BorderThickness="1,0,0,0">
                <Grid RowSpacing="12" Padding="14,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" RowSpacing="{StaticResource Space200}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Height="28">
                            <TextBlock
                                x:Name="DockTitle"
                                FontFamily="{StaticResource AppFontFamily}"
                                FontSize="{StaticResource FontSizeSmall}"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource InkBrush}"
                                VerticalAlignment="Center" />
                            <Button
                                Width="28"
                                Height="28"
                                HorizontalAlignment="Right"
                                AutomationProperties.Name="Close panel"
                                Click="OnToggleRunPanelClick"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTipService.ToolTip="Close panel">
                                <Path
                                    Data="M6 6 L18 18 M18 6 L6 18"
                                    Style="{StaticResource IconSmallStyle}" />
                            </Button>
                        </Grid>

                        <!-- Two tabs: Changes and Files -->
                        <Border
                            Grid.Row="1"
                            Height="32"
                            Padding="3"
                            Background="{ThemeResource SunkenBrush}"
                            CornerRadius="{StaticResource RadiusPill}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    x:Name="ChangesTabButton"
                                    Grid.Column="0"
                                    AutomationProperties.Name="Changes"
                                    Click="OnDockTabClick"
                                    Style="{StaticResource TabStyle}"
                                    Tag="changes"
                                    ToolTipService.ToolTip="Changes">
                                    <Path
                                        x:Name="ChangesTabIcon"
                                        Data="M12 3 A9 9 0 1 0 12 21 A9 9 0 1 0 12 3 Z M12 7 V12 L15 14"
                                        Style="{StaticResource TabIconStyle}" />
                                </Button>
                                <Button
                                    x:Name="FilesTabButton"
                                    Grid.Column="1"
                                    AutomationProperties.Name="Files"
                                    Click="OnDockTabClick"
                                    Style="{StaticResource TabStyle}"
                                    Tag="files"
                                    ToolTipService.ToolTip="Files">
                                    <Path
                                        x:Name="FilesTabIcon"
                                        Data="M3 7 A1 1 0 0 1 4 6 H9 L11 8 H20 A1 1 0 0 1 21 9 V18 A1 1 0 0 1 20 19 H4 A1 1 0 0 1 3 18 Z"
                                        Style="{StaticResource TabIconStyle}" />
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1">
                        <!-- Changes view -->
                        <StackPanel x:Name="ChangesView" Spacing="12">
                            <StackPanel Spacing="3">
                                <TextBlock Style="{StaticResource SectionCaptionTextStyle}" Text="CHANGED FILES" />
                                <ItemsControl x:Name="ChangesList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:HistoryRow">
                                            <Border
                                                Margin="0,0,0,4"
                                                Padding="9,7"
                                                Background="{ThemeResource SunkenBrush}"
                                                BorderBrush="{ThemeResource HairlineBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource RadiusSmall}">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Spacing="2">
                                                        <TextBlock
                                                            FontFamily="{StaticResource MonoFontFamily}"
                                                            FontSize="{StaticResource FontSizeMicro}"
                                                            FontWeight="SemiBold"
                                                            Foreground="{ThemeResource InkBrush}"
                                                            Text="{x:Bind Title}"
                                                            TextTrimming="CharacterEllipsis"
                                                            TextWrapping="NoWrap" />
                                                        <TextBlock
                                                            Style="{StaticResource SectionCaptionTextStyle}"
                                                            Text="{x:Bind Age}"
                                                            TextTrimming="CharacterEllipsis"
                                                            TextWrapping="NoWrap" />
                                                    </StackPanel>
                                                    <Border
                                                        Grid.Column="1"
                                                        Padding="6,2"
                                                        Background="{ThemeResource AccentSoftBrush}"
                                                        CornerRadius="8"
                                                        VerticalAlignment="Center">
                                                        <TextBlock
                                                            FontFamily="{StaticResource MonoFontFamily}"
                                                            FontSize="{StaticResource FontSizeMicro}"
                                                            FontWeight="SemiBold"
                                                            Foreground="{ThemeResource AccentInkBrush}"
                                                            Text="+N" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock
                                    x:Name="ChangesEmpty"
                                    Style="{StaticResource SectionCaptionTextStyle}"
                                    Text="No changes yet."
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Compact Tokens and Speed indicators -->
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Style="{StaticResource SectionCaptionTextStyle}" Text="TOKENS" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse
                                            x:Name="TokenDot"
                                            Width="6"
                                            Height="6"
                                            Fill="{ThemeResource AccentBrush}"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            x:Name="RunTokens"
                                            FontFamily="{StaticResource MonoFontFamily}"
                                            FontSize="{StaticResource FontSizeSmall}"
                                            Foreground="{ThemeResource InkBrush}"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Style="{StaticResource SectionCaptionTextStyle}" Text="SPEED" />
                                    <TextBlock
                                        x:Name="RunRate"
                                        FontFamily="{StaticResource MonoFontFamily}"
                                        FontSize="{StaticResource FontSizeSmall}"
                                        Foreground="{ThemeResource InkBrush}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <panels:FilesPanel x:Name="FilesView" Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
