<ContentDialog
    x:Class="ZX0ai.Views.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Settings"
    PrimaryButtonText="Save"
    SecondaryButtonText="Cancel"
    PrimaryButtonClick="OnPrimaryButtonClick"
    SecondaryButtonClick="OnSecondaryButtonClick"
    DefaultButton="Primary">

    <ScrollViewer MaxHeight="720" Padding="20">
        <StackPanel Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Provider" />
                <ComboBox x:Name="ProviderComboBox" SelectionChanged="OnProviderChanged" />
                <TextBlock Text="Select the backend provider used for chat requests." TextWrapping="Wrap" />
            </StackPanel>

            <Border Background="{ThemeResource SunkenBrush}" CornerRadius="8" Padding="12">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="OpenRouter Settings" />
                    <TextBlock Text="OpenRouter API key variable and base URL." TextWrapping="Wrap" />
                    <TextBlock Text="API key env var" />
                    <TextBox x:Name="OpenRouterApiKeyVariable" />
                    <TextBlock Text="Base URL (fixed by the app)" />
                    <TextBox x:Name="OpenRouterBaseUrl" IsReadOnly="True" />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource SunkenBrush}" CornerRadius="8" Padding="12">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Qwen Settings" />
                    <TextBlock Text="Qwen 3.8 Max settings: env var, endpoint, model, and request parameters." TextWrapping="Wrap" />
                    <TextBlock Text="API key env var" />
                    <TextBox x:Name="QwenApiKeyVariable" />
                    <TextBlock Text="Base URL" />
                    <TextBox x:Name="QwenBaseUrl" />
                    <TextBlock Text="Default model" />
                    <TextBox x:Name="QwenDefaultModel" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Temperature" />
                            <TextBox x:Name="QwenTemperature" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Top P" />
                            <TextBox x:Name="QwenTopP" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Max tokens" />
                    <TextBox x:Name="QwenMaxTokens" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                        <TextBlock Text="Stream responses" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="QwenStream" />
                    </StackPanel>
                    <TextBlock Text="Reasoning level" />
                    <TextBox x:Name="QwenReasoningLevel" />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource SunkenBrush}" CornerRadius="8" Padding="12">
                <StackPanel Spacing="6">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="API Key Handling" />
                    <TextBlock Text="ZX0ai reads the API key from the named environment variable only. The app does not store the secret." TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
