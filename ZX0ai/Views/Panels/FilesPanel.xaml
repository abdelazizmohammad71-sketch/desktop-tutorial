<UserControl
    x:Class="ZX0ai.Views.Panels.FilesPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="{StaticResource Space200}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="{StaticResource Space200}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Height="30"
                Padding="{StaticResource RowPadding}"
                Background="{ThemeResource SunkenBrush}"
                CornerRadius="{StaticResource RadiusPill}">
                <Grid ColumnSpacing="{StaticResource Space150}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path
                        Grid.Column="0"
                        Data="M11 4 A7 7 0 1 0 11 18 A7 7 0 1 0 11 4 Z M16.2 16.2 L21 21"
                        Style="{StaticResource IconSmallStyle}" />
                    <TextBox
                        x:Name="FilterBox"
                        Grid.Column="1"
                        FontSize="{StaticResource FontSizeMicro}"
                        PlaceholderText="Filter"
                        Style="{StaticResource BareTextBoxStyle}"
                        TextChanged="OnFilterChanged"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Button
                Grid.Column="1"
                AutomationProperties.Name="Refresh"
                Click="OnRefreshClick"
                Style="{StaticResource IconButtonStyle}"
                ToolTipService.ToolTip="Refresh">
                <Path
                    Data="M20 12 A8 8 0 1 1 17 5.8 M20 4 V10 H14"
                    Style="{StaticResource IconSmallStyle}" />
            </Button>

            <Button
                Grid.Column="2"
                AutomationProperties.Name="Open in Explorer"
                Click="OnRevealClick"
                Style="{StaticResource IconButtonStyle}"
                ToolTipService.ToolTip="Open in Explorer">
                <Path
                    Data="M14 4 H20 V10 M20 4 L12 12 M18 14 V19 A1 1 0 0 1 17 20 H5 A1 1 0 0 1 4 19 V7 A1 1 0 0 1 5 6 H10"
                    Style="{StaticResource IconSmallStyle}" />
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <TreeView
                x:Name="Tree"
                CanDragItems="False"
                CanReorderItems="False"
                ItemInvoked="OnItemInvoked"
                SelectionMode="Single" />

            <TextBlock
                x:Name="EmptyNote"
                Style="{StaticResource SectionCaptionTextStyle}"
                Text="No folder is bound."
                TextWrapping="Wrap"
                VerticalAlignment="Top" />
        </Grid>
    </Grid>
</UserControl>
