<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>ZX0ai</RootNamespace>
    <AssemblyName>ZX0ai</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <!--
      Restore pulls a full runtime pack per RID. This dev machine is disk-tight,
      so only x64 is listed; add win-x86/win-arm64 here when packaging for release.
    -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <ApplicationIcon>Assets\zx0ai.ico</ApplicationIcon>
    <DefaultLanguage>en-US</DefaultLanguage>
  </PropertyGroup>

  <!--
    Deployment mode.

    Default (ZX0aiPackaged unset): unpackaged, Windows App SDK self-contained.
    Produces a plain .exe that runs by double-click with no Developer Mode, no
    MSIX registration and no separately installed Windows App Runtime.

    -p:ZX0aiPackaged=true: single-project MSIX using Package.appxmanifest, for
    Store/enterprise distribution and packaged-identity APIs.
  -->
  <PropertyGroup>
    <ZX0aiPackaged Condition="'$(ZX0aiPackaged)' == ''">false</ZX0aiPackaged>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' AND '$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' AND '$(Platform)' == 'x86'">win-x86</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' AND '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ZX0aiPackaged)' == 'true'">
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ZX0aiPackaged)' != 'true'">
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup Condition="'$(ZX0aiPackaged)' == 'true'">
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZX0ai.Core\ZX0ai.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*.png" />
    <Content Include="Assets\**\*.ico" />
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Theme dictionaries are merged at runtime, so they must ship as XAML pages. -->
  <ItemGroup>
    <Page Update="Themes\Tokens.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Themes\Controls.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

</Project>
