<UserControl
    x:Class="ZX0ai.Views.Panels.TerminalPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:ZX0ai.Services"
    mc:Ignorable="d">

    <!--
        Everything run in the folder, by the agent or by the user, in one scrollback.
        The output is a left-to-right island whatever the shell's flow direction: a
        stack trace mirrored under RTL is unreadable.
    -->
    <Grid RowSpacing="{StaticResource Space200}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal"
            Spacing="{StaticResource Space100}"
            HorizontalAlignment="Right">
            <Button
                x:Name="StopButton"
                AutomationProperties.Name="Stop"
                Click="OnStopClick"
                IsEnabled="False"
                Style="{StaticResource IconButtonStyle}"
                ToolTipService.ToolTip="Stop">
                <Path Data="M8 8 H16 V16 H8 Z" Style="{StaticResource IconSmallStyle}" />
            </Button>
            <Button
                AutomationProperties.Name="Copy output"
                Click="OnCopyClick"
                Style="{StaticResource IconButtonStyle}"
                ToolTipService.ToolTip="Copy output">
                <Path
                    Data="M9 9 H19 V19 H9 Z M5 15 V5 H15"
                    Style="{StaticResource IconSmallStyle}" />
            </Button>
            <Button
                AutomationProperties.Name="Clear"
                Click="OnClearClick"
                Style="{StaticResource IconButtonStyle}"
                ToolTipService.ToolTip="Clear">
                <Path
                    Data="M5 7 H19 M6.5 7 L7.5 20 H16.5 L17.5 7"
                    Style="{StaticResource IconSmallStyle}" />
            </Button>
        </StackPanel>

        <Border
            Grid.Row="1"
            Background="{ThemeResource SunkenBrush}"
            CornerRadius="{StaticResource RadiusSmall}">
            <ScrollViewer
                x:Name="Scroller"
                Padding="{StaticResource CardPadding}"
                FlowDirection="LeftToRight"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Auto"
                VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="OutputList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="services:TerminalLine">
                            <TextBlock
                                FontFamily="{StaticResource MonoFontFamily}"
                                FontSize="{StaticResource FontSizeMicro}"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind Text}"
                                TextWrapping="NoWrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Border
            Grid.Row="2"
            Padding="{StaticResource RowPadding}"
            Background="{ThemeResource RaisedBrush}"
            BorderBrush="{ThemeResource HairlineBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusSmall}"
            MinHeight="34">
            <Grid ColumnSpacing="{StaticResource Space200}" FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    FontFamily="{StaticResource MonoFontFamily}"
                    FontSize="{StaticResource FontSizeMicro}"
                    Foreground="{ThemeResource InkTertiaryBrush}"
                    Text="&gt;"
                    VerticalAlignment="Center" />
                <TextBox
                    x:Name="CommandBox"
                    Grid.Column="1"
                    FontFamily="{StaticResource MonoFontFamily}"
                    FontSize="{StaticResource FontSizeMicro}"
                    KeyDown="OnCommandKeyDown"
                    PlaceholderText="Run a command"
                    Style="{StaticResource BareTextBoxStyle}"
                    VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
